# ==========================================
# DISCORD BOT CREDENTIALS
# ==========================================
# 1. Visit: https://discord.com/developers/applications
# 2. Create a "New Application" -> Go to "Bot" tab -> Click "Reset Token"
# 3. Enable "MESSAGE CONTENT INTENT" under Privileged Gateway Intents
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_bot_application_id_here

# (Optional) Guild ID for instant slash command registration during development.
# If omitted, slash commands are registered globally across all servers.
GUILD_ID=

# ==========================================
# LAVALINK AUDIO SERVER CONFIGURATION
# ==========================================
# Default local Lavalink v4 server settings:
# In Pterodactyl, localhost works only when Java Lavalink runs in this same container.
# For a separate server use its reachable allocation and matching TLS/port/password.
# Set false to ignore the custom endpoint and use public fallbacks only.
LAVALINK_CUSTOM_ENABLED=true
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# ==========================================
# SPOTIFY CATALOG METADATA (OPTIONAL; DOES NOT SUPPLY AUDIO)
# ==========================================
# Enables Spotify API catalog suggestions, not Spotify Premium audio streaming.
# 1. Visit: https://developer.spotify.com/dashboard
# 2. Create an app e.g. "South Conclave Music" and select Web API.
# Spotify currently requires Premium for the development-mode app owner.
# If required by the form, redirect URI: http://127.0.0.1:8888/callback
# This bot uses client credentials; it does not use that callback or user login.
# 3. Copy Client ID and Client Secret below:
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ==========================================
# AUDIO REGION & SOURCES
# ==========================================
# YouTube bitrate depends on the actual stream/node; search does not guarantee 256 kbps.
# JioSaavn requests 320 kbps when available. These are lossy sources, not lossless.
# If you have a Deezer account via VPN/International, you can optionally put your ARL token here:
DEEZER_ARL=

# Set false to use only your configured Lavalink node (requires LAVALINK_HOST).
# This keeps public nodes from changing your controlled audio pipeline.
LAVALINK_PUBLIC_FALLBACKS=true
