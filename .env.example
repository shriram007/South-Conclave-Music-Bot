# ==========================================
# DISCORD BOT CREDENTIALS
# ==========================================
# 1. Visit: https://discord.com/developers/applications
# 2. Create a "New Application" -> Go to "Bot" tab -> Click "Reset Token"
# 3. Enable "MESSAGE CONTENT INTENT" under Privileged Gateway Intents
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_bot_application_id_here

# (Optional) Guild ID for instant slash command registration during development.
# If omitted, slash commands are registered globally across all servers.
GUILD_ID=

# ==========================================
# LAVALINK AUDIO SERVER CONFIGURATION
# ==========================================
# Default local Lavalink v4 server settings:
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# ==========================================
# SPOTIFY METADATA RESOLVER (FREE)
# ==========================================
# Enables searching and playing Spotify song/album/playlist links!
# 1. Visit: https://developer.spotify.com/dashboard
# 2. Log in and click "Create App" (App name can be anything)
# 3. Copy Client ID and Client Secret below:
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ==========================================
# AUDIO REGION & SOURCES
# ==========================================
# Audio is streamed using YouTube Music 256k HQ & JioSaavn 320k HQ (Lossless/Studio standard in India).
# If you have a Deezer account via VPN/International, you can optionally put your ARL token here:
DEEZER_ARL=

# Set false to use only your configured Lavalink node (requires LAVALINK_HOST).
# This keeps public nodes from changing your controlled audio pipeline.
LAVALINK_PUBLIC_FALLBACKS=true
